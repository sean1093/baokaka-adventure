{
  "name": "baokaka-adventure",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "vite-node scripts/sim.ts",
    "solve": "vite-node scripts/solve-pages.ts",
    "visual": "node scripts/visual-check.mjs --serve",
    "visual:update": "node scripts/visual-check.mjs --serve --update",
    "check:ui": "node scripts/ui-check.mjs --serve",
    "check:play": "node scripts/play-check.mjs --serve",
    "qa": "npm run visual && npm run check:ui && npm run check:play"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "pixelmatch": "7.1.0",
    "playwright": "1.56.1",
    "pngjs": "7.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
