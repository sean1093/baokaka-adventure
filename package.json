{
  "name": "baokaka-adventure",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build -c vite.popup3d.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "vite-node scripts/sim.ts",
    "solve": "vite-node scripts/solve-pages.ts",
    "sync:sprites": "vite-node scripts/sync-sprites.ts",
    "bake:popup": "vite-node scripts/bake-popup.ts",
    "art:report": "vite-node scripts/art-report.ts",
    "fonts": "vite-node scripts/fonts/charset.ts && python3 scripts/fonts/subset.py",
    "fonts:session": "npm run build && node scripts/fonts/first-session.mjs",
    "visual": "node scripts/visual-check.mjs --serve",
    "visual:update": "node scripts/visual-check.mjs --serve --update",
    "check:ui": "node scripts/ui-check.mjs --serve",
    "check:ui:big": "UI_TEXT=big node scripts/ui-check.mjs --serve --popup",
    "check:play": "node scripts/play-check.mjs --serve",
    "check:prod": "node scripts/prod-check.mjs --build",
    "check:perf": "node scripts/perf-check.mjs --build",
    "qa": "npm run visual && npm run check:ui && npm run check:play",
    "bake:3d": "vite-node scripts/bake-3d.ts",
    "check:3d": "node scripts/spike3d-check.mjs --build"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "pixelmatch": "7.1.0",
    "playwright": "1.56.1",
    "pngjs": "7.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
